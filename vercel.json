{
  "buildCommand": "npm run build:vercel",
  "outputDirectory": "public",
  "installCommand": "npm ci",
  "framework": null,
  "rewrites": [
    {
      "source": "/app/:path*",
      "destination": "/app/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
