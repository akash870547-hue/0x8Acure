NODE_ENV=development
PORT=8080
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
DB_PATH=./data/dpdp-ctf.db

# Cyber Lab PostgreSQL (the Docker Compose database is published on port 54329)
DATABASE_URL=postgresql://postgres:postgres@localhost:54329/0x8acure?schema=public

# Supabase project values. Never put the service role key in a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=replace-with-public-anon-or-publishable-key
VITE_API_BASE_URL=

# AssetPulse integrations (server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PRO_PLAN_ID=

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=0x8acure-admin
# Optional stable UUID for a database-seeded admin before first Supabase login.
SEED_ADMIN_USER_ID=
